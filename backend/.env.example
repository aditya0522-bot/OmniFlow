# development or production. Production refuses to start with a weak SECRET_KEY.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./omniflow.db
SECRET_KEY=replace-with-a-long-random-string-of-32-or-more-characters
CORS_ORIGINS=http://localhost:5173
TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
SENTRY_DSN=

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
ALLOW_SIGNUP=true

# Shared by the Meta app. Each workspace saves its own phone number ID and access token in Settings.
WHATSAPP_VERIFY_TOKEN=omniflow-verify
WHATSAPP_APP_SECRET=
# Development shortcuts only, ignored when ENVIRONMENT=production
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Sample data and the public demo. Never enable SEED_DEMO_DATA on a real production database.
DEMO_MODE=false
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@omniflow.local
SEED_ADMIN_PASSWORD=admin123
